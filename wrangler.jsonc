// Cloudflare Workers config for COILSIDE.
// Built with @opennextjs/cloudflare.
//
// COILSIDE is local-first. User data and field photos stay in the browser
// (localStorage + IndexedDB). The Worker only serves the app and static assets.
// No D1, KV, R2, Durable Objects, Cloudflare Images, or other paid bindings are
// required for the current app.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "coilside",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
