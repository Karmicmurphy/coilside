// COILSIDE existing production Worker, built with @opennextjs/cloudflare.
// Dedicated D1 created and bound by Cloudflare Agent Lee on 2026-10-15.
// Keep the D1 binding in source so later Wrangler deploys do not lose it.
// Equipment photo R2 storage remains deliberately deferred.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "coilside",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "COILSIDE_DB",
      "database_name": "coilside-team-2026",
      "database_id": "228d72be-effe-4f17-9889-e06ef87f2826",
      "migrations_dir": "migrations"
    }
  ]
}
